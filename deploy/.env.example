# Copy to ~/polymarket/.env on the VM (next to compose.yml) and fill in.

# Where sealed files go: abfss://<container>@<account>.dfs.core.windows.net/<folder>
LANDING=abfss://polymarket@stpolymarketdev.dfs.core.windows.net/landing

# Prefix of the source id in remote file names (letters, digits, - and _ only).
HOST_ID=vm1

# Image tag to run. Default: latest. Set to a commit sha to roll back.
# TAG=
